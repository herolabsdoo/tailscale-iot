@@ -444,7 +444,19 @@ func (m *mapper) buildFromChange(
 		builder.WithPingRequest(resp.PingRequest)
 	}
 
-	return builder.Build()
+	mapResp, err := builder.Build()
+	if err != nil {
+		return nil, err
+	}
+
+	// tailscale-iot: nothing visible to this node is left, send no frame (upstream sends ~300 B of ControlTime).
+	if !resp.SendAllPeers && !resp.IncludeSelf && !resp.IncludeDERPMap && !resp.IncludeDNS &&
+		!resp.IncludeDomain && !resp.IncludePolicy && resp.PingRequest == nil &&
+		len(mapResp.PeersChanged) == 0 && len(mapResp.PeersChangedPatch) == 0 && len(mapResp.PeersRemoved) == 0 {
+		return nil, nil //nolint:nilnil // nothing visible to this node, nothing to send
+	}
+
+	return mapResp, nil
 }
 
